name: Monthly NOAA observatory check
on:
  schedule: [{cron: '0 12 10 * *'}]   # 10th of every month, 12:00 UTC
  workflow_dispatch:
concurrency: {group: dashboard-data, cancel-in-progress: false}   # never overlap with the weekly refresh
jobs:
  noaa:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/cache/restore@v4
        with:
          path: |
            build/data
            build/geoscf
            build/airs
            build/firesm
            build/ndvi_hi
          key: dashboard-data-${{ github.run_id }}
          restore-keys: dashboard-data-
      - uses: actions/setup-python@v5
        with: {python-version: '3.11'}
      - run: pip install numpy pillow requests playwright && python -m playwright install --with-deps chromium
      # refresh NOAA flask, observatory and near-real-time data, rebuild and test the page
      - run: STEPS="compose noaa stations assemble test split" bash build/run_all.sh
      - run: python3 build/noaa_check.py dashboard-single.html build/data
      - run: |
          git config user.name "dashboard-bot" && git config user.email "bot@users.noreply.github.com"
          git add index.html dashboard-single.html data
          if git diff --cached --quiet; then echo "No new NOAA data this month."; exit 0; fi
          git commit -m "NOAA monthly check $(date -u +%F)" && git pull --rebase && git push
